{
  "name": "dtu-upcycled-3d-backend",
  "version": "1.0.0",
  "description": "Backend API for Upcycled Fishing Net & Ocean Accessories E-Commerce with Free-form 3D Customizer & Hybrid AWS S3 Media Storage",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "seed": "node src/seeds/seed.js",
    "s3:sync": "node src/scripts/syncToS3.js",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.658.1",
    "@aws-sdk/s3-request-presigner": "^3.658.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.6.1",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1"
  }
}
