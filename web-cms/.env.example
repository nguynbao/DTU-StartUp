# ==============================================================================
# VERCEL ENVIRONMENT VARIABLES — WEB CMS (web-cms/)
# Copy these variables into Vercel Project Settings -> Environment Variables
# ==============================================================================

# URL Backend API tren Render (VD: https://dtu-upcycled-backend.onrender.com/api)
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# URL Web Store tren Vercel (VD: https://dtu-coastal-store.vercel.app)
NEXT_PUBLIC_STORE_URL=http://localhost:3000

# URL Web CMS tren Vercel (VD: https://dtu-coastal-cms.vercel.app)
NEXT_PUBLIC_CMS_URL=http://localhost:3002

# AWS S3 Public Bucket Base URL cho toan bo hinh anh san pham & nguyen lieu 3D
NEXT_PUBLIC_S3_BASE_URL=https://dtu-img-db-868017909899-ap-southeast-2-an.s3.ap-southeast-2.amazonaws.com

# Demo Admin Credentials (chi dung cho moi truong thu nghiem)
NEXT_PUBLIC_DEFAULT_ADMIN_EMAIL=admin@dtu-upcycled.vn
NEXT_PUBLIC_DEFAULT_ADMIN_PASSWORD=admin123

# Chu ky (phut) tu dong gui request danh thuc Backend Render tranh ngu dong (Mac dinh: 8 phut)
NEXT_PUBLIC_KEEP_ALIVE_MINUTES=8
